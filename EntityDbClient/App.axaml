<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="EntityDbClient.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, sans-serif" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#25354B" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,5" /><Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DCE3ED" /><Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#EEF3FC" /><Setter Property="BorderBrush" Value="#BACAE5" /></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#2563EB" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#2563EB" /></Style>
    <Style Selector="Button.accent:pointerover"><Setter Property="Background" Value="#1D4ED8" /></Style>
    <Style Selector="Button.quiet, Button.tab-close"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.tab-close"><Setter Property="MinHeight" Value="22" /><Setter Property="MinWidth" Value="22" /><Setter Property="Padding" Value="3,0" /><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="32" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="TextBlock.muted, TextBlock.status"><Setter Property="Foreground" Value="#68758A" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TreeViewItem"><Setter Property="Padding" Value="6,5" /><Setter Property="MinHeight" Value="30" /></Style>
    <Style Selector="TabControl.connections"><Setter Property="Background" Value="#EDF1F7" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="TabControl.connections > TabItem"><Setter Property="Padding" Value="16,9" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="TabControl.documents > TabItem"><Setter Property="Padding" Value="12,7" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TabControl.documents, TabControl.editor-tabs"><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="TabControl.editor-tabs > TabItem"><Setter Property="Padding" Value="12,8" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="DataGrid"><Setter Property="RowHeight" Value="34" /><Setter Property="BorderBrush" Value="#E2E7EF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5" /><Setter Property="VerticalGridLinesBrush" Value="#EDF0F5" /></Style>
    <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="#F5F7FA" /><Setter Property="Foreground" Value="#526078" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="8,6" /></Style>
    <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="600" /></Style>
  </Application.Styles>
</Application>
